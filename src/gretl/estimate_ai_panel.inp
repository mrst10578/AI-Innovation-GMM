# Standalone gretl real-data estimation; source generated by estimate_panel.py in Actions.
# Log output is primary audit trail, no invented test statistics.
open "data/processed/model_panel.csv" --quiet
setobs panel_id Year --panel-vars
printf "GRETL_REAL_DATA_SAMPLE: "
eval $nobs
# Static comparison
ols HighTech_Exports 0 ln1p_invest ln1p_patent GDP_Growth --robust
ols Unemployment 0 ln1p_invest ln1p_patent GDP_Growth --robust
panel HighTech_Exports 0 ln1p_invest ln1p_patent GDP_Growth --fixed-effects --robust
panel Unemployment 0 ln1p_invest ln1p_patent GDP_Growth --fixed-effects --robust
# One-step difference GMM; short lag windows, collapsed instrument matrix, year dummies.
printf "GRETL_GMM_2024_HIGH_TECH_DIFFERENCE\n"
dpanel 1 ; HighTech_Exports ln1p_invest ln1p_patent GDP_Growth ; GMM(HighTech_Exports,2,3) GMM(ln1p_invest,2,3) GMM(ln1p_patent,2,3) GMM(GDP_Growth,2,3) --collapse --time-dummies
printf "GRETL_GMM_2024_UNEMPLOYMENT_DIFFERENCE\n"
dpanel 1 ; Unemployment ln1p_invest ln1p_patent GDP_Growth ; GMM(Unemployment,2,3) GMM(ln1p_invest,2,3) GMM(ln1p_patent,2,3) GMM(GDP_Growth,2,3) --collapse --time-dummies
printf "GRETL_GMM_2024_HIGH_TECH_SYSTEM\n"
dpanel 1 ; HighTech_Exports ln1p_invest ln1p_patent GDP_Growth ; GMM(HighTech_Exports,2,3) GMM(ln1p_invest,2,3) GMM(ln1p_patent,2,3) GMM(GDP_Growth,2,3) --collapse --system --time-dummies
printf "GRETL_GMM_2024_UNEMPLOYMENT_SYSTEM\n"
dpanel 1 ; Unemployment ln1p_invest ln1p_patent GDP_Growth ; GMM(Unemployment,2,3) GMM(ln1p_invest,2,3) GMM(ln1p_patent,2,3) GMM(GDP_Growth,2,3) --collapse --system --time-dummies
# Restrict to 2016-2023, keep nominal panel completeness.
smpl Year < 2024 --restrict --preserve-panel
printf "GRETL_GMM_2023_HIGH_TECH_DIFFERENCE\n"
dpanel 1 ; HighTech_Exports ln1p_invest ln1p_patent GDP_Growth ; GMM(HighTech_Exports,2,3) GMM(ln1p_invest,2,3) GMM(ln1p_patent,2,3) GMM(GDP_Growth,2,3) --collapse --time-dummies
printf "GRETL_GMM_2023_UNEMPLOYMENT_DIFFERENCE\n"
dpanel 1 ; Unemployment ln1p_invest ln1p_patent GDP_Growth ; GMM(Unemployment,2,3) GMM(ln1p_invest,2,3) GMM(ln1p_patent,2,3) GMM(GDP_Growth,2,3) --collapse --time-dummies
smpl full
printf "GRETL_SCRIPT_FINISHED\n"
