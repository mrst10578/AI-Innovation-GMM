. display as text "OUTCOME=`outcome'; independent models of unemployment and high-tech share."
OUTCOME=HighTech_Exports; independent models of unemployment and high-tech share.

. local successful_gmm = 0

. foreach cutoff in 2024 2023 {
  2.     preserve
  3.     keep if Year <= `cutoff'
  4.     xtset panel_id Year
  5.     local td "yr2017-yr2024"
  6.     if `cutoff' == 2023 local td "yr2017-yr2023"
  7.     display as result "======== SAMPLE END `cutoff' ========"
  8.     quietly count
  9.     display as result "INPUT_ROWS=" r(N)
 10.     * Dynamic pooled OLS and within FE are biased comparison models, not causal benchmarks.
.     capture noisily regress `outcome' L.`outcome' ln_ai_investment ln_ai_patents GDP_Growth `td', vce(cluster panel_id
> )
 11.     if !_rc {
 12.         estimates store `slug'_ols`cutoff'
 13.         estimates save "outputs/stata/`slug'_ols`cutoff'.ster", replace
 14.     }
 15.     else display as error "POOLED OLS FAILED for `slug'/`cutoff'"
 16.     capture noisily xtreg `outcome' L.`outcome' ln_ai_investment ln_ai_patents GDP_Growth `td', fe vce(cluster pane
> l_id)
 17.     if !_rc {
 18.         estimates store `slug'_fe`cutoff'
 19.         estimates save "outputs/stata/`slug'_fe`cutoff'.ster", replace
 20.     }
 21.     else display as error "DYNAMIC FE FAILED for `slug'/`cutoff'"
 22.     * Collapse + a single lag depth restricts instrument proliferation at N=30.
.     * One lag of L.y yields instruments dated no later than y_(t-2).
.     * AI regressors are treated as endogenous, not proven exogenous.
.     * GDP growth and year indicators are provisionally strictly exogenous: sensitivity needed.
.     foreach system in system difference {
 23.         foreach steps in onestep twostep {
 24.             local eqopts ""
 25.             local stepopts ""
 26.             if "`steps'" == "twostep" local stepopts "twostep"
 27.             local instruments "ivstyle(GDP_Growth `td', equation(both))"
 28.             if "`system'" == "difference" {
 29.                 local eqopts "noleveleq"
 30.                 local instruments "ivstyle(GDP_Growth `td', equation(diff))"
 31.             }
 32.             local idprefix = substr("`slug'",1,2)
 33.             local ident "`idprefix'_`system'_`steps'_`cutoff'"
 34.             display as result "GMM `slug' `cutoff' `system' `steps'"
 35.             capture noisily xtabond2 `outcome' L.`outcome' ln_ai_investment ln_ai_patents GDP_Growth `td', ///
>                 gmmstyle(L.`outcome', laglimits(1 1) collapse) ///
>                 gmmstyle(ln_ai_investment ln_ai_patents, laglimits(2 2) collapse) ///
>                 `instruments' `eqopts' `stepopts' robust small
 36.             local rc = _rc
 37.             if `rc' {
 38.                 display as error "MODEL_FAILED outcome=`slug' cutoff=`cutoff' system=`system' step=`steps' rc=`rc'"
 39.                 post ai_post ("`ident'") ("FAILED") (`rc') (.) (.) (.) (.) (.) (.) (.)
 40.             }
 41.             else {
 42.                 local successful_gmm = `successful_gmm' + 1
 43.                 local verdict "UNVALIDATED"
 44.                 if missing(e(j),e(N_g),e(ar2p),e(hansenp)) local verdict "DIAGNOSTIC_HOLD"
 45.                 if !missing(e(j),e(N_g),e(ar2p),e(hansenp)) {
 46.                     if e(j)>=e(N_g) | e(ar2p)<0.05 | e(hansenp)<0.05 | e(hansenp)>0.95 local verdict "DIAGNOSTIC_HO
> LD"
 47.                 }
 48.                 post ai_post ("`ident'") ("`verdict'") (0) (e(N)) (e(N_g)) (e(j)) (e(sarganp)) (e(hansenp)) (e(ar1p
> )) (e(ar2p))
 49.                 display as result "DIAGNOSTIC_STATUS=`verdict' Hansen=" e(hansenp) " AR2=" e(ar2p) " instruments=" 
> e(j)
 50.                 estimates store `ident'
 51.                 estimates save "outputs/stata/`ident'.ster", replace
 52.                 display as result "MODEL_EXECUTED_BUT_NOT_YET_VALIDATED `ident'"
 53.                 ereturn list
 54.                 matrix list e(b)
 55.                 * Hansen/Sargan, AR(1)/AR(2), instrument count and subset tests:
.                 * use actual xtabond2 output above; do not fabricate missing diagnostics.
.             }
 56.         }
 57.     }
 58.     restore
 59. }
