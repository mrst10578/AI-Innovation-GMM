. foreach v in HighTech_Exports Unemployment ln_ai_investment ln_ai_patents GDP_Growth {
  2.     display as text "IPS unit root test, intercept, 1 ADF lag: `v'"
  3.     capture noisily xtunitroot ips `v', lags(1)
  4.     if _rc {
