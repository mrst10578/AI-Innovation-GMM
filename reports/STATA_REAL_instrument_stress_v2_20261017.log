end of do-file

. local rc = _rc

. if `rc' {
.     display as error "SECOND_ROUND_DATA_PREFLIGHT_FAILED rc=`rc'"
.     log close
.     exit `rc'
. }

. capture which xtabond2

. if _rc {
.     display as error "xtabond2 missing; previously staged Winlator PLUS directory required."
.     log close
.     exit 499
. }

. postfile ai2 str32 model str24 status double rc N Ng instruments sargan_p hansen_p ar1_p ar2_p lag_b inv_b patents_b g
> dp_b using "outputs/stata/stress_v2_diagnostics.dta", replace
(file outputs/stata/stress_v2_diagnostics.dta not found)

. local fit_count = 0

. local failed_count = 0

. foreach dep in HighTech_Exports Unemployment {
  2.     local prefix "hi"
  3.     if "`dep'"=="Unemployment" local prefix "un"
  4.     foreach cutoff in 2024 2023 {
  5.         preserve
  6.         keep if Year<=`cutoff'
  7.         xtset panel_id Year
  8.         local td "yr2018-yr2024"
  9.         if `cutoff'==2023 local td "yr2018-yr2023"
 10.         foreach spec in D23_X D23_E S23_X S23_E {
 11.             local tag "`prefix'_`cutoff'_`spec'"
 12.             local eq "noleveleq"
 13.             local controls "ivstyle(GDP_Growth `td', equation(diff))"
 14.             local gdp ""
 15.             if strpos("`spec'","_E")>0 {
 16.                 local gdp "gmmstyle(GDP_Growth, laglimits(2 3) collapse)"
 17.                 local controls "ivstyle(`td', equation(diff))"
 18.             }
 19.             if substr("`spec'",1,1)=="S" {
 20.                 local eq ""
 21.                 local controls "ivstyle(GDP_Growth `td', equation(both))"
 22.                 if strpos("`spec'","_E")>0 local controls "ivstyle(`td', equation(both))"
 23.             }
 24.             display as result "STRESS_ATTEMPT=`tag' (prior specification; do not cherry-pick)"
 25.             capture noisily xtabond2 `dep' L.`dep' ln_ai_investment ln_ai_patents GDP_Growth `td', ///
>                 gmmstyle(L.`dep', laglimits(1 2) collapse) ///
>                 gmmstyle(ln_ai_investment ln_ai_patents, laglimits(2 3) collapse) ///
>                 `gdp' `controls' `eq' twostep robust small
 26.             local rc = _rc
 27.             if `rc' {
 28.                 local failed_count = `failed_count'+1
 29.                 display as error "STRESS_FAILED=`tag' rc=`rc'"
 30.                 post ai2 ("`tag'") ("FAILED") (`rc') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 31.             }
 32.             else {
 33.                 local fit_count = `fit_count'+1
 34.                 local status "SCIENTIFIC_HOLD"
 35.                 if missing(e(j),e(N_g),e(ar2p),e(hansenp)) local status "DIAGNOSTIC_HOLD"
 36.                 if !missing(e(j),e(N_g),e(ar2p),e(hansenp)) {
 37.                     if e(j)>=e(N_g) | e(ar2p)<0.05 | e(hansenp)<0.05 | e(hansenp)>.95 local status "DIAGNOSTIC_HOLD
> "
 38.                 }
 39.                 post ai2 ("`tag'") ("`status'") (0) (e(N)) (e(N_g)) (e(j)) (e(sarganp)) (e(hansenp)) (e(ar1p)) (e(a
> r2p)) (_b[L.`dep']) (_b[ln_ai_investment]) (_b[ln_ai_patents]) (_b[GDP_Growth])
 40.                 display as result "STRESS_FITTED=`tag' status=`status' N=" e(N) " inst=" e(j) " Hansen=" e(hansenp)
>  " AR2=" e(ar2p)
 41.                 estimates save "outputs/stata/stress_`tag'.ster", replace
 42.                 ereturn list
 43.             }
 44.         }
 45.         restore
 46.     }
 47. }
