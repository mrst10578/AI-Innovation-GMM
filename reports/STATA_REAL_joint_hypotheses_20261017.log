. local opened=0

. local missingfits=0

. foreach dep in HighTech_Exports Unemployment {
  2.     local short "hi"
  3.     if "`dep'"=="Unemployment" local short "un"
  4.     foreach cutoff in 2024 2023 {
  5.         foreach spec in D23_X D23_E S23_X S23_E {
  6.             local ident "`short'_`cutoff'_`spec'"
  7.             capture noisily estimates use "outputs/stata/stress_`ident'.ster"
  8.             if _rc {
  9.                 local missingfits=`missingfits'+1
 10.                 post wald ("`ident'") (601) (.) (.) (.) (.) (.) (.) (.)
 11.                 display as error "WALD_MISSING_ESTIMATE `ident'"
 12.             }
 13.             else {
 14.                 local opened=`opened'+1
 15.                 local n=e(N)
 16.                 local ng=e(N_g)
 17.                 local k=e(j)
 18.                 local jointp=.
 19.                 local jointF=.
 20.                 local persistp=.
 21.                 local persistF=.
 22.                 capture noisily test ln_ai_investment ln_ai_patents
 23.                 local rcj=_rc
 24.                 if !`rcj' {
 25.                     local jointp=r(p)
 26.                     capture local jointF=r(F)
 27.                     if missing(`jointF') capture local jointF=r(chi2)
 28.                 }
 29.                 capture noisily test L.`dep'=1
 30.                 local rcp=_rc
 31.                 if !`rcp' {
 32.                     local persistp=r(p)
 33.                     capture local persistF=r(F)
 34.                     if missing(`persistF') capture local persistF=r(chi2)
 35.                 }
 36.                 post wald ("`ident'") (max(`rcj',`rcp')) (`jointp') (`jointF') (`persistp') (`persistF') (`n') (`ng
> ') (`k')
 37.                 display as result "STRESS_WALD=`ident' pAI=`jointp' pLAG_EQ1=`persistp' joint_rc=`rcj' lag_rc=`rcp'
> "
 38.             }
 39.         }
 40.     }
 41. }

