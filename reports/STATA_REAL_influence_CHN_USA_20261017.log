. local rc=_rc

. if `rc' {
.     display as error "INFLUENCE_SOURCE_CHECK_FAILED rc=`rc'"
.     log close
.     exit `rc'
. }

. capture which xtabond2

. if _rc {
.     display as error "XTABOND2_UNAVAILABLE"
.     log close
.     exit 499
. }

. postfile loo str28 model str12 dropped str22 outcome double cutoff rc N Ng instruments sargan_p hansen_p ar1_p ar2_p l
> ag_b inv_b patent_b gdp_b using "outputs/stata/influence_v1.dta", replace
(file outputs/stata/influence_v1.dta not found)

. local successes=0

. local fails=0

. foreach dep in HighTech_Exports Unemployment {
  2.     local short "hi"
  3.     if "`dep'"=="Unemployment" local short "un"
  4.     foreach cutoff in 2024 2023 {
  5.         local td "yr2017-yr2024"
  6.         if `cutoff'==2023 local td "yr2017-yr2023"
  7.         foreach drop in CHN USA BOTH {
  8.             preserve
  9.             keep if Year<=`cutoff'
 10.             if "`drop'"=="CHN" drop if ISO3=="CHN"
 11.             if "`drop'"=="USA" drop if ISO3=="USA"
 12.             if "`drop'"=="BOTH" drop if inlist(ISO3,"CHN","USA")
 13.             xtset panel_id Year
 14.             local tag "`short'_`cutoff'_`drop'"
 15.             display as result "INFLUENCE_ATTEMPT=`tag'"
 16.             quietly count
 17.             display as result "INFLUENCE_INPUT_N=" r(N)
 18.             capture noisily xtabond2 `dep' L.`dep' ln_ai_investment ln_ai_patents GDP_Growth `td', ///
>                 gmmstyle(L.`dep', laglimits(1 1) collapse) ///
>                 gmmstyle(ln_ai_investment ln_ai_patents, laglimits(2 2) collapse) ///
>                 ivstyle(GDP_Growth `td', equation(both)) twostep robust small
 19.             local rc=_rc
 20.             if `rc' {
 21.                 local fails=`fails'+1
 22.                 display as error "INFLUENCE_FAILED=`tag' rc=`rc'"
 23.                 post loo ("`tag'") ("`drop'") ("`dep'") (`cutoff') (`rc') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (
> .)
 24.             }
 25.             else {
 26.                 local successes=`successes'+1
 27.                 post loo ("`tag'") ("`drop'") ("`dep'") (`cutoff') (0) (e(N)) (e(N_g)) (e(j)) (e(sarganp)) (e(hanse
> np)) (e(ar1p)) (e(ar2p)) (_b[L.`dep']) (_b[ln_ai_investment]) (_b[ln_ai_patents]) (_b[GDP_Growth])
 28.                 display as result "INFLUENCE_FITTED=`tag' Ng=" e(N_g) " inst=" e(j) " Hansen=" e(hansenp) " AR2=" e
> (ar2p)
 29.                 estimates save "outputs/stata/influence_`tag'.ster", replace
 30.             }
 31.             restore
 32.         }
 33.     }
 34. }
